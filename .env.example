# GGBot 环境变量模板
# 首次安装时会复制为 .env；已有 .env 不会被覆盖。
# 只填写实际使用的项目。请勿把包含真实密钥的 .env 提交到 Git。

# ------------------------------
# 基础运行配置
# ------------------------------
DATABASE_URL=sqlite:///data/database.db
# 允许可信局域网和 Tailnet 访问；管理面板无登录认证，请勿映射到公网。
WEB_HOST=0.0.0.0
WEB_PORT=8888
WX_BOT_PORT=5555
LOG_LEVEL=INFO
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=120
LLM_HISTORY_MAX_TEXT_CHARS=50000
WECHAT_BOT_NAME=微信助手

# 主应用与微信桥接不在默认地址时才填写；留空会根据上述端口自动生成。
MAIN_APP_URL=
WX_BOT_URL=

# 使用项目自带的同源管理面板时保持为空；多个来源用英文逗号分隔。
WEB_CORS_ORIGINS=

# 保持 false：首次运行不注入旧版预设模型和任务路由。
LLM_ENABLE_LEGACY_DEFAULT_MAPPINGS=false

# ------------------------------
# 模型供应商凭据（全部可选）
# 推荐直接在“模型连接”页面保存凭据；只有选择 env::环境变量方式时才填写这里。
# 同一供应商需要多个 Key 时，管理面板会为不同连接生成独立的 GGBOT_MODEL_*_API_KEY 名称。
# ------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
OPENROUTER_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
PERPLEXITYAI_API_KEY=
COHERE_API_KEY=
TOGETHERAI_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_AI_API_KEY=

# 自定义 OpenAI 兼容接口或“其他 LiteLLM 供应商”的通用凭据名。
CUSTOM_LLM_API_KEY=
LLM_API_KEY=

# ------------------------------
# 链接摘要插件（可选）
# ------------------------------
# 抖音、TikTok 和部分小红书媒体解析使用；普通网页/公众号摘要不需要。
TIKHUB_API_TOKEN=

# ------------------------------
# 本机 Codex 集成（可选；周报助手需要）
# true 表示 Codex 安装在 WSL；false 表示使用 Windows 可执行文件。
# ------------------------------
CODEX_PROXY_USE_WSL=true
CODEX_PROXY_WSL_BIN=codex
CODEX_PROXY_BIN=
CODEX_PROXY_WORKDIR=
CODEX_PROXY_MODEL=gpt-5.6-sol
CODEX_PROXY_REASONING_EFFORT=high
CODEX_PROXY_WEB_SEARCH=true
CODEX_PROXY_TIMEOUT=900
CODEX_PROXY_ARTIFACT_ROOT=tmp/images/codex

# 统一 Codex 运行时与进程池。global 表示跟随系统全局 Codex 升级。
CODEX_BINARY_POLICY=global
CODEX_CONFIG_POLICY=inherit
CODEX_INTERACTIVE_POOL_SIZE=1
CODEX_INTERACTIVE_PROCESS_CONCURRENCY=4
CODEX_BATCH_POOL_SIZE=1
CODEX_BATCH_PROCESS_CONCURRENCY=1
CODEX_VERSION_CHECK_INTERVAL_SECONDS=60
CODEX_POOL_DRAIN_TIMEOUT_SECONDS=60
CODEX_RUNTIME_STATE_DB=data/codex_runtime.db
RUNTIME_OPERATIONS_DB=data/runtime_operations.db

# Codex 应用服务器可保持默认；线程状态文件和生成物都位于本地运行目录。
CODEX_APP_SERVER_ENABLED=true
CODEX_APP_SERVER_STARTUP_TIMEOUT=30
CODEX_APP_SERVER_ROTATE_TOKENS=220000
CODEX_APP_SERVER_THREAD_STATE=data/codex_app_server_threads.json
CODEX_USAGE_REFRESH_TIMEOUT=30
CODEX_HOME=

# 仅在需要保护本地 Codex 代理接口时设置访问密钥。
CODEX_PROXY_KEY=

# 备份与运行记录。当前备份格式会直接包含 .env，请只保存在可信位置。
SYSTEM_BACKUP_DIR=data/system_backups
SYSTEM_BACKUP_MAX_IMPORT_GB=50
CODEX_JOB_RETENTION_DAYS=30
CODEX_UPGRADE_TIMEOUT_SECONDS=600
CODEX_CIRCUIT_FAILURE_THRESHOLD=3
CODEX_CIRCUIT_RESET_SECONDS=30
CODEX_ARTIFACT_RETENTION_DAYS=30
CODEX_ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600

# ------------------------------
# QQ 邮件通知（可选）
# QQEMAIL_CODE 应填写 SMTP 授权码，不是 QQ 登录密码。
# ------------------------------
QQEMAIL_ADDR=
QQEMAIL_CODE=

# ------------------------------
# Windows 登录后自动启动与微信登录恢复（可选）
# ------------------------------
WECHAT_AUTOLOGIN_INITIAL_DELAY=60
WECHAT_AUTOLOGIN_TIMEOUT=180
WECHAT_AUTOLOGIN_POLL_INTERVAL=5
WECHAT_AUTOLOGIN_ENTER_INTERVAL=20
WECHAT_AUTOLOGIN_DISPLAY_TIMEOUT=180
WECHAT_AUTOLOGIN_START_DELAY=15
WXAUTOX_START_TARGET=Start-GUI.bat
