{
  "schema_version": 2,
  "plugin_api_version": 2,
  "storage": {"cache_retention_days": 1, "cache_limit_mb": 512},
  "backup": {"schema_version": 1, "include_persistent_storage": false, "include_generated_files": false, "supports_restore_migration": false, "sensitive": false},
  "health": {"critical": false, "timeout_seconds": 5},
  "listeners": [
    {"event": "text_message_received", "handler": "handle_text_message", "title": "开始红酒鉴定", "trigger": {"kind": "keyword", "summary": "消息包含任一鉴定关键词", "config_keys": ["trigger_keywords"], "conditions": ["命中后进入等待图片会话"]}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"},
    {"event": "image_message_received", "handler": "handle_image_message", "title": "接收红酒图片", "trigger": {"kind": "session", "summary": "当前发送者存在等待图片的红酒鉴定会话", "config_keys": [], "conditions": []}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"},
    {"event": "quote_image_message_received", "handler": "handle_quote_image_message", "title": "引用图片鉴定", "trigger": {"kind": "keyword", "summary": "引用图片并包含任一鉴定关键词", "config_keys": ["trigger_keywords"], "conditions": ["引用内容必须包含图片"]}, "scope": {"level": "global", "chat_types": ["group", "user"]}, "propagation": "stop_on_consumed"}
  ],
  "jobs": []
}
