# ------------------------------
# Application
# ------------------------------
DATABASE_URL=sqlite:///data/database.db
WEB_HOST=127.0.0.1
WEB_PORT=8888
WX_BOT_PORT=5555
LOG_LEVEL=INFO
WECHAT_BOT_NAME=微信助手

# Leave empty when using the bundled same-origin Web console.
WEB_CORS_ORIGINS=

# Public builds never inject preset model IDs or task mappings.
LLM_ENABLE_LEGACY_DEFAULT_MAPPINGS=false

# ------------------------------
# AI provider credentials (optional)
# Add only the providers referenced by models you create in the Web console.
# ------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
CUSTOM_LLM_API_KEY=

# ------------------------------
# Local Codex integration (optional; required by the Weekly plugin)
# true: Codex is installed inside WSL; false: use a Windows executable.
# ------------------------------
CODEX_PROXY_USE_WSL=true
CODEX_PROXY_WSL_BIN=codex
CODEX_PROXY_BIN=
CODEX_PROXY_MODEL=gpt-5.6-sol
CODEX_PROXY_REASONING_EFFORT=high
CODEX_PROXY_WEB_SEARCH=true
CODEX_PROXY_TIMEOUT=900
CODEX_APP_SERVER_ENABLED=true
CODEX_PROXY_KEY=

# ------------------------------
# Offline email notification (optional)
# ------------------------------
QQEMAIL_ADDR=
QQEMAIL_CODE=
